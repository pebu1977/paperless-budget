# --- Paperless-Verbindung -------------------------------------------------
# Interne Adresse, unter der der Container Paperless erreicht
PAPERLESS_URL=http://paperless-webserver:8000
# API-Token: Paperless > Profil (oben rechts) > API-Auth-Token
PAPERLESS_TOKEN=hier-token-einfuegen
# Öffentliche Adresse für Links "Dokument öffnen" im Browser
PAPERLESS_PUBLIC_URL=https://paperless.example.ch
# Bei selbstsigniertem Zertifikat auf false setzen
PAPERLESS_VERIFY_SSL=true
# Optional: API-Version fixieren (leer = Paperless-Standard)
PAPERLESS_API_VERSION=

# --- Budget ---------------------------------------------------------------
# Name des Custom Fields (Typ Währung/Monetary) mit dem Betrag
AMOUNT_FIELD_NAME=Total
CURRENCY=CHF

# --- Abgleich mit Kontoauszügen -------------------------------------------
PAID_TAG_NAME=bezahlt
# Tag für Bestellbestätigungen (werden vorgemerkt, bis Rechnung oder Abbuchung da ist)
ORDER_TAG_NAME=Bestellung
# Rechnung bzw. Abbuchung wird so viele Tage nach der Bestellung erwartet
ORDER_EXPECT_DAYS=30
PAID_FIELD_NAME=Bezahlt am

# --- Traccar (Kilometer pro Fahrzeug) -------------------------------------
# Adresse des Traccar-Servers (im selben Docker-Netz z.B. http://traccar:8082)
TRACCAR_URL=
# Entweder Token (Traccar > Einstellungen > Konto > Token) ...
TRACCAR_TOKEN=
# ... oder Benutzer/Passwort
TRACCAR_USER=
TRACCAR_PASSWORD=
TRACCAR_VERIFY_SSL=true

# --- Zugriffsschutz (optional, empfohlen falls nicht hinter NPM-Access-List) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Zähler (optional): Home Assistant als Quelle für Zählerstände --------
# Langlebiges Zugangs-Token: Home Assistant > Profil > Sicherheit > Langlebige Zugangs-Token
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
# Zähler so oft automatisch ablesen (Minuten)
METER_POLL_MINUTES=60
